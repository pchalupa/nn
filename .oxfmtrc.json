{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 120,
	"endOfLine": "lf",
	"insertFinalNewline": true,
	"sortImports": true,
	"sortPackageJson": true,
	"ignorePatterns": ["**/node_modules", "**/dist", "**/coverage", "**/apps/example-react/src/routeTree.gen.ts"],
	"overrides": [
		{
			"files": ["apps/example-react/**"],
			"options": {
				"sortTailwindcss": {
					"stylesheet": "./apps/example-react/src/main.css"
				}
			}
		}
	]
}
