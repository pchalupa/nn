{
	"[javascript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"editor.formatOnSave": true,
	"typescript.tsdk": "node_modules/typescript/lib",
	"latex-workshop.latex.tools": [
		{
			"name": "latexmk",
			"command": "latexmk",
			"args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"],
			"cwd": "%DIR%"
		}
	],
	"latex-workshop.latex.recipes": [
		{
			"name": "latexmk",
			"tools": ["latexmk"]
		}
	],
	"latex-workshop.latex.outDir": "%DIR%/build",
	"files.exclude": {
		"**/*.aux": true,
		"**/*.bbl": true,
		"**/*.bcf": true,
		"**/*.blg": true,
		"**/*.fdb_latexmk": true,
		"**/*.fls": true,
		"**/*.lof": true,
		"**/*.lot": true,
		"**/*.nav": true,
		"**/*.out": true,
		"**/*.run.xml": true,
		"**/*.snm": true,
		"**/*.synctex.gz": true,
		"**/*.toc": true,
		"**/*.xdv": true,
		"**/main.log": true,
		"**/missfont.log": true
	}
}
