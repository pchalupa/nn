                      "width": "fill_container",
                      "content": "// main.tsx\nimport \"@radix-ui/themes/styles.css\";\nimport { Theme } from \"@radix-ui/themes\";\n\n<Theme appearance=\"dark\" accentColor=\"violet\" grayColor=\"gray\">\n  <RouterProvider router={router} />\n</Theme>\n\n// Defaults kept: radius=\"medium\", scaling=\"100%\",\n// panelBackground=\"translucent\", system font stack.\n// The canvas renders the system stack with Inter and Menlo\n// with Noto Sans Mono, since system fonts are unavailable here.\n\n// Component recipes used in the design\n<Button>                                     solid violet, size 2\n<Button variant=\"soft\" color=\"gray\">\n<Button variant=\"ghost\" color=\"gray\">\n<Button color=\"red\">                         destructive\n<IconButton size=\"1\" variant=\"ghost\" color=\"gray\">\n<TextField.Root />                           surface, 32px\n<TextArea />\n<Badge color=\"violet\">                       ticket label, soft\n<Badge variant=\"outline\" color=\"gray\">       add label\n<Badge size=\"2\" color=\"green\">               sync status\n<Badge size=\"2\" variant=\"surface\" color=\"gray\">  presence\n<Avatar size=\"1\" fallback=\"PC\" />           soft, radius-2\n<Avatar size=\"1\" variant=\"solid\" fallback={<BotIcon />} />\n<Card>                                       column, ticket card\n<Card size=\"3\">                              sign-in card\n<DropdownMenu.Content>                       assignee, account\n<AlertDialog.Content>                        confirm delete\n<Kbd>",
                      "lineHeight": "$line-height-1",
                      "fontFamily": "$code-font-family",
                      "fontSize": "$font-size-1",
                      "fontWeight": "$font-weight-regular"
                    }
