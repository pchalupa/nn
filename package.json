{
	"name": "nn",
	"version": "1.0.0",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"build": "pnpm -r --parallel build",
		"ts:check": "pnpm -r --parallel ts:check",
		"ts:watch": "pnpm -r --parallel ts:check --watch",
		"lint:check": "oxlint",
		"lint:write": "oxlint --fix",
		"format:check": "oxfmt --check .",
		"format:write": "oxfmt .",
		"spell:check": "cspell --no-progress **/*.{ts,tsx,json,md,tex}",
		"clutter:check": "knip",
		"test": "vitest --run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest test --coverage",
		"bench": "vitest bench --run",
		"bench:watch": "vitest bench",
		"changeset:add": "changeset ",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@cspell/dict-cs-cz": "^3.0.10",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@vitest/coverage-v8": "^5.1.0",
		"cspell": "^10.5.2",
		"knip": "^6.46.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.21.0"
}
