{
	"name": "nn",
	"version": "1.0.0",
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"ts:check": "pnpm -r --parallel ts:check",
		"lint:check": "oxlint",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"spell:check": "cspell --no-progress **/*.{ts,tsx,json,md,tex}",
		"clutter:check": "knip --cache --cache-location node_modules/.cache/knip",
		"test": "vitest",
		"test:watch": "vitest watch",
		"test:coverage": "vitest test --coverage",
		"changeset:add": "changeset ",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@vitest/coverage-v8": "catalog:",
		"cspell": "^10.3.3",
		"knip": "^6.37.0",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.5.2"
}
