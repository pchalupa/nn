{
	"name": "nn",
	"version": "1.0.0",
	"description": "",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"scripts": {
		"dev": "pnpm -r --parallel run dev",
		"ts:check": "pnpm -r --parallel ts:check",
		"ts:watch": "pnpm -r --parallel ts:check --watch",
		"lint:check": "oxlint",
		"lint:write": "oxlint --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"spell:check": "cspell --no-progress **/*.{ts,tsx,json,md,tex}",
		"clutter:check": "knip --production",
		"test": "vitest --run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest test --coverage",
		"bench": "vitest bench --run",
		"bench:watch": "vitest bench",
		"changeset:add": "changeset ",
		"changeset:version": "changeset version",
		"changeset:publish": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@cspell/dict-cs-cz": "^3.0.10",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vitest/coverage-v8": "catalog:",
		"cspell": "^10.4.0",
		"knip": "^6.44.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.28.10"
}
