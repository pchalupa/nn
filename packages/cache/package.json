{
	"name": "@goodstate/cache",
	"version": "1.0.0",
	"description": "Caches for values derived from other state",
	"keywords": [
		"cache",
		"invalidation",
		"memoization"
	],
	"homepage": "https://github.com/pchalupa/goodstate/tree/main/packages/cache#readme",
	"bugs": {
		"url": "https://github.com/pchalupa/goodstate/issues"
	},
	"license": "MIT",
