	"repository": {
		"type": "git",
		"url": "git+https://github.com/pchalupa/goodstate.git",
		"directory": "packages/cache"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./invalidatable-cache": "./src/invalidatable-cache.ts",
		"./versioned-cache": "./src/versioned-cache.ts",
		"./package.json": "./package.json"
	},
