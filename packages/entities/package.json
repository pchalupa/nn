{
	"name": "@nn/entities",
	"version": "3.1.0",
	"description": "Conflict-free replicated data types that a store keeps its state in",
	"keywords": [
		"crdt",
		"local-first",
		"lww-map",
		"lww-register",
		"rga"
	],
	"homepage": "https://github.com/pchalupa/nn/tree/main/packages/entities#readme",
	"bugs": {
		"url": "https://github.com/pchalupa/nn/issues"
	},
	"license": "MIT",
	"author": "pchalupa <chalupa.petr93@gmail.com> (https://github.com/pchalupa)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pchalupa/nn.git",
		"directory": "packages/entities"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		"./codable": "./src/codable.ts",
		"./codec": "./src/codec.ts",
		"./entity": "./src/entity.ts",
		"./kinds/lww-map": "./src/lww-map.ts",
		"./kinds/lww-register": "./src/lww-register.ts",
		"./kinds/rga": "./src/rga.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./codable": "./dist/codable.js",
			"./codec": "./dist/codec.js",
			"./entity": "./dist/entity.js",
			"./kinds/lww-map": "./dist/kinds/lww-map.js",
			"./kinds/lww-register": "./dist/kinds/lww-register.js",
			"./kinds/rga": "./dist/kinds/rga.js",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@nn/guards": "workspace:^",
		"@nn/id": "workspace:^",
		"@nn/observable": "workspace:^",
		"@nn/time": "workspace:^"
	},
	"devDependencies": {
		"@nn/build-config": "workspace:^",
		"@nn/typescript-config": "workspace:^",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
