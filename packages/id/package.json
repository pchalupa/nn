{
	"name": "@nn/id",
	"version": "0.1.1",
	"description": "Local ID generation",
	"keywords": [
		"id",
		"uuid",
		"uuid-v4"
	],
	"homepage": "https://github.com/pchalupa/nn/tree/main/packages/id#readme",
	"bugs": {
		"url": "https://github.com/pchalupa/nn/issues"
	},
	"license": "MIT",
	"author": "pchalupa <chalupa.petr93@gmail.com> (https://github.com/pchalupa)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pchalupa/nn.git",
		"directory": "packages/id"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"@nn/source": "./src/id.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"devDependencies": {
		"@nn/typescript-config": "workspace:^",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
