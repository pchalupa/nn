{
	"name": "@nn/schema",
	"version": "2.1.0",
	"description": "Typed schema builders that describe the shape of store state",
	"keywords": [
		"json-schema",
		"schema",
		"type-inference",
		"typescript"
	],
	"homepage": "https://github.com/pchalupa/nn/tree/main/packages/schema#readme",
	"bugs": {
		"url": "https://github.com/pchalupa/nn/issues"
	},
	"license": "MIT",
	"author": "pchalupa <chalupa.petr93@gmail.com> (https://github.com/pchalupa)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pchalupa/nn.git",
		"directory": "packages/schema"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./array-schema": "./src/array-schema.ts",
		"./boolean-schema": "./src/boolean-schema.ts",
		"./enumeration-schema": "./src/enumeration-schema.ts",
		"./number-schema": "./src/number-schema.ts",
		"./object-schema": "./src/object-schema.ts",
		"./string-schema": "./src/string-schema.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./array-schema": "./dist/array-schema.js",
			"./boolean-schema": "./dist/boolean-schema.js",
			"./enumeration-schema": "./dist/enumeration-schema.js",
			"./number-schema": "./dist/number-schema.js",
			"./object-schema": "./dist/object-schema.js",
			"./string-schema": "./dist/string-schema.js",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"devDependencies": {
		"@nn/build-config": "workspace:^",
		"@nn/typescript-config": "workspace:^",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
