{
	"name": "@nn/sse-sync",
	"version": "3.0.0",
	"description": "Sync engine that keeps a store in sync with a server over server-sent events",
	"keywords": [
		"eventsource",
		"local-first",
		"realtime",
		"server-sent-events",
		"sse",
		"sync"
	],
	"homepage": "https://github.com/pchalupa/nn/tree/main/packages/sse-sync#readme",
	"bugs": {
		"url": "https://github.com/pchalupa/nn/issues"
	},
	"license": "MIT",
	"author": "pchalupa <chalupa.petr93@gmail.com> (https://github.com/pchalupa)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pchalupa/nn.git",
		"directory": "packages/sse-sync"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"@nn/source": "./src/sse-sync.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@nn/entities": "workspace:^",
		"@nn/guards": "workspace:^",
		"@nn/observable": "workspace:^",
		"@nn/store": "workspace:^",
		"@nn/sync-engine": "workspace:^"
	},
	"devDependencies": {
		"@nn/schema": "workspace:^",
		"@nn/typescript-config": "workspace:^",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
