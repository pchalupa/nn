{
	"name": "@nn/time",
	"version": "1.0.1",
	"description": "Hybrid logical clock",
	"keywords": [
		"clock",
		"crdt",
		"hlc",
		"hybrid-logical-clock",
		"timestamp"
	],
	"homepage": "https://github.com/pchalupa/nn/tree/main/packages/time#readme",
	"bugs": {
		"url": "https://github.com/pchalupa/nn/issues"
	},
	"license": "MIT",
	"author": "pchalupa <chalupa.petr93@gmail.com> (https://github.com/pchalupa)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pchalupa/nn.git",
		"directory": "packages/time"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"@nn/source": "./src/time.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"dependencies": {
		"@nn/id": "workspace:^"
	},
	"devDependencies": {
		"@nn/typescript-config": "workspace:^",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
