{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Nn",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "ES2025.Collection", "DOM"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noUnusedLocals": true,
		"incremental": true,
		"tsBuildInfoFile": "${configDir}/node_modules/.cache/tsbuildinfo"
	},
	"exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
